[
    {
        // Bar for DP-1 (screen 1) - owns real workspaces 1-5
        "output": "DP-1",
        "layer": "top",
        "position": "top",
        "exclusive": true,
        "spacing": 0,
        "include": ["~/.config/waybar/modules-common.jsonc"],

        "modules-left": ["cpu", "custom/gpu", "memory", "temperature", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "wlr/taskbar"],
        "modules-center": ["clock"],
        "modules-right": ["tray", "custom/wifi", "pulseaudio", "custom/power"],

        "custom/ws1": { "exec": "~/.config/waybar/scripts/workspace-info.sh 1", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=1})\"" },
        "custom/ws2": { "exec": "~/.config/waybar/scripts/workspace-info.sh 2", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=2})\"" },
        "custom/ws3": { "exec": "~/.config/waybar/scripts/workspace-info.sh 3", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=3})\"" },
        "custom/ws4": { "exec": "~/.config/waybar/scripts/workspace-info.sh 4", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=4})\"" },
        "custom/ws5": { "exec": "~/.config/waybar/scripts/workspace-info.sh 5", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=5})\"" },

        "clock": {
            "format": "{:%H:%M}",
            "format-alt": "{:%Y-%m-%d (%A)}",
            "on-click": "qs -c noctalia-shell ipc call calendar toggle",
            "on-click-right": "mode"
        }
    },
    {
        // Bar for HDMI-A-1 (screen 2) - owns real workspaces 6-10, displayed as 1-5
        "output": "HDMI-A-1",
        "layer": "top",
        "position": "top",
        "exclusive": true,
        "spacing": 0,
        "include": ["~/.config/waybar/modules-common.jsonc"],

        "modules-left": ["cpu", "custom/gpu", "memory", "temperature", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "wlr/taskbar"],
        "modules-center": ["clock"],
        "modules-right": ["tray", "custom/wifi", "pulseaudio", "custom/power"],

        "custom/ws6": { "exec": "~/.config/waybar/scripts/workspace-info.sh 6", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=6})\"" },
        "custom/ws7": { "exec": "~/.config/waybar/scripts/workspace-info.sh 7", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=7})\"" },
        "custom/ws8": { "exec": "~/.config/waybar/scripts/workspace-info.sh 8", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=8})\"" },
        "custom/ws9": { "exec": "~/.config/waybar/scripts/workspace-info.sh 9", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=9})\"" },
        "custom/ws10": { "exec": "~/.config/waybar/scripts/workspace-info.sh 10", "return-type": "json", "interval": 5, "signal": 8, "on-click": "hyprctl dispatch \"hl.dsp.focus({workspace=10})\"" },

        "clock": {
            "format": "{:%H:%M}",
            "format-alt": "{:%Y-%m-%d (%A)}",
            "on-click": "qs -c noctalia-shell ipc call calendar toggle",
            "on-click-right": "mode"
        }
    }
]
